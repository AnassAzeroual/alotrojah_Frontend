{
  "name": "alotrojah",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/set-version.mjs",
    "start": "ng serve -o --host=0.0.0.0",
    "prestart:prod": "node scripts/set-version.mjs",
    "start:prod": "ng serve --configuration production",
    "prebuild": "node scripts/set-version.mjs",
    "build": "ng build",
    "prebuild:dev": "node scripts/set-version.mjs",
    "build:dev": "ng build --configuration development",
    "prewatch": "node scripts/set-version.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/set-version.mjs",
    "test": "ng test --watch=false",
    "pretest:watch": "node scripts/set-version.mjs",
    "test:watch": "ng test --watch",
    "pretest:cov": "node scripts/set-version.mjs",
    "test:cov": "ng test --watch=false --coverage",
    "e2e": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e.ps1",
    "e2e:menu": "powershell -ExecutionPolicy Bypass -File scripts/e2e-menu.ps1",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts",
    "lint": "eslint src",
    "pretypecheck": "node scripts/set-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "e2e:direct": "playwright test",
    "shots": "node scripts/shots.mjs",
    "perf:load": "node scripts/load-test.mjs",
    "perf:test": "node --test scripts/load-test.test.mjs",
    "api:sync": "node scripts/sync-api.mjs"
  },
  "engines": {
    "node": "^24"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "angular-calendar": "^0.32.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "flatpickr": "^4.6.13",
    "ng-cryptostore": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular-eslint/utils": "^22.6.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@hey-api/openapi-ts": "^0.97.3",
    "@playwright/test": "^1.63.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  }
}
